# SafeEscrowX - Frontend Environment Variables

# Backend URL (REQUIRED)
# Replace with your actual backend URL after deployment
# Examples:
#   Render: https://escrowx-backend-xyz.onrender.com
#   Railway: https://your-app.railway.app
#   VPS: http://123.45.67.89:10000
#   Local: http://localhost:10000
VITE_BACKEND_URL=https://your-backend-url-here.com

# Admin Password (REQUIRED)
# Change this to a strong, secure password
VITE_ADMIN_PASSWORD=YourSecurePassword123!

# IMPORTANT:
# 1. Copy this file and rename it to .env
# 2. Replace the values above with your actual values
# 3. NEVER commit .env file to GitHub
# 4. Keep your tokens and passwords secret!
