# SafeEscrowX - Backend Environment Variables

# Server Port
PORT=10000

# Database URL
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///escrow.db
# PostgreSQL (for production, optional):
# DATABASE_URL=postgresql://user:password@localhost:5432/escrowx

# JWT Secret Key (CHANGE THIS to a random secret!)
# Generate a random string: https://randomkeygen.com/
JWT_SECRET=your-super-secret-key-change-this-to-random-text-12345

# Telegram Bot Token (REQUIRED)
# Get from @BotFather on Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram Channels (REQUIRED for force join)
MAIN_CHANNEL=@SafeEscrowX
TUTORIAL_CHANNEL=@SafeEscrowXTutorials

# Environment
# Use development for local runs so .env is loaded by server.js
NODE_ENV=development

# IMPORTANT:
# 1. Copy this file and rename it to .env
# 2. Replace BOT_TOKEN with your actual bot token from @BotFather
# 3. Change JWT_SECRET to a random secure string
# 4. NEVER commit .env file to GitHub
# 5. Keep your tokens and passwords secret!
